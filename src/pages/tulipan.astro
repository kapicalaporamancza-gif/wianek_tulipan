---
import Layout from '../layouts/Layout.astro';
import SubscriptionModal from '../components/SubscriptionModal.astro';
import backgroundShape from '../../resources/tło.webp';
import book from '../../resources/1.webp';
import people from '../../resources/2.webp';
import tulipanOne from '../../resources/tulipan 1.webp';
import tulipanTwo from '../../resources/tulipan 2.webp';
import tulipanThree from '../../resources/tulipan 3.webp';
import tulipanFour from '../../resources/tulipan 4.webp';
---

<Layout
  title="Wydawnictwo Wianek — O idealnym Tulipanie"
  description="Dołącz do społeczności Wydawnictwa Wianek i otrzymuj darmowe materiały, ciekawostki, nowości oraz oferty specjalne."
>
  <!-- Tło -->
  <img
    src={backgroundShape.src}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0 h-full w-full object-cover object-center translate-y-[35%] lg:translate-y-0 lg:object-center"
  />

  <!-- Nagłówek -->
  <header class="relative z-20 px-5 pt-6 pb-6 text-center lg:absolute lg:right-[7.5%] lg:top-[6%] lg:p-0 lg:text-right">
    <a
      href="#top"
      class="extra-bold text-sm font-bold uppercase tracking-wide text-wianek-rust sm:text-lg lg:text-xl"
      aria-label="Wydawnictwo Wianek — strona główna"
    >
      WYDAWNICTWO WIANEK
    </a>
  </header>

  <!-- Postać w prawym górnym rogu -->
  <img
    src={tulipanFour.src}
    alt=""
    aria-hidden="true"
    class="corner-flower hero-flower pointer-events-none absolute -right-[2.6%] top-[2%] z-20 hidden w-[7%] lg:block"
    loading="lazy"
    decoding="async"
  />

  <!-- Książka -->
  <img
    src={book.src}
    alt="Okładka książki „O idealnym Tulipanie”"
    loading="eager"
    decoding="async"
    class="hidden lg:block book-image relative z-10 lg:absolute lg:left-[7%] lg:top-1/2 lg:w-[24%] lg:-translate-y-[47%]"
  />

  <!-- Tekst (środek) -->
  <section
    class="relative z-10 order-1 mx-auto mt-8 w-full max-w-xl px-5 text-center lg:absolute lg:left-[29%] lg:top-1/2 lg:mx-0 lg:mt-0 lg:w-[36%] lg:max-w-none lg:-translate-y-1/2 lg:px-0 lg:text-left"
  >
    <h1 class="extra-bold text-xl font-bold uppercase leading-snug tracking-wide text-wianek-rust sm:text-2xl lg:text-wianek-cream lg:text-[clamp(1.4rem,2.4vw,2.3rem)]">
      Zostań częścią<br />wiankowych historii!
    </h1>
    <p class="mt-1 text-sm leading-relaxed text-wianek-rust sm:text-sm lg:text-wianek-cream lg:text-[clamp(1rem,1.5vw,1.35rem)]">
      Nie przegap darmowych materiałów do zabawy<br /> i pracy z naszymi książkami, ciekawostek<br class="lg:hidden" /> oraz nowości.
    </p>

    <button
      id="open-subscription"
      type="button"
      class="extra-bold mt-8 inline-flex min-h-12 items-center justify-center rounded-full bg-wianek-green px-8 py-3 text-base font-bold uppercase text-wianek-cream shadow-lg shadow-wianek-green/20 transition hover:-translate-y-0.5 hover:bg-wianek-green-dark lg:mt-12 lg:ml-[30%] lg:px-12 lg:py-5 lg:text-2xl"
    >
      Dołącz do nas
    </button>
  </section>

  <!-- Postać w prawym dolnym rogu -->
  <img
    src={tulipanOne.src}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    class="hero-flower pointer-events-none absolute right-[8%] -bottom-[2%] z-10 w-[40%] lg:bottom-[-3%] lg:right-[-1%] lg:w-[15%]"
  />

  <!-- Postać w środku -->
  <img
    src={tulipanTwo.src}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    class="hero-flower pointer-events-none absolute right-[58%] -bottom-[2%] z-10 w-[40%] lg:bottom-[-3%] lg:right-[18%] lg:w-[14%]"
  />

  <!-- Postać w lewym dolnym rogu -->
  <img
    src={tulipanThree.src}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    class="hero-flower pointer-events-none absolute -left-[2%] bottom-[-1%] z-10 hidden w-[13%] lg:block"
  />

  <img
    src={people.src}
    alt="Twórczynie Wydawnictwa Wianek z książkami"
    loading="eager"
    decoding="async"
    class="absolute left-1/2 -translate-x-1/2 -bottom-[8%] z-10
    w-[38%] max-w-none
    lg:left-auto lg:translate-x-0 lg:right-[9%] lg:-bottom-[10%] lg:w-[13%]"
  />

  <SubscriptionModal theme="tulipan" />
</Layout>
