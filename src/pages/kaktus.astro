---
import '../styles/global.css';
import backgroundShape from '../../resources/O_Kaktusku_tlo.webp';
import people from '../../resources/O_Kaktusku_zadziorku.webp';
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Dołącz do społeczności Wydawnictwa Wianek i otrzymuj darmowe materiały, ciekawostki, nowości oraz oferty specjalne."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Wydawnictwo Wianek</title>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="font-andika">
    <main id="top" class="relative h-[100dvh] min-h-[600px] overflow-hidden lg:min-h-screen">
        <!-- Tło -->
      <img
        src={backgroundShape.src}
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 z-0 h-full w-full object-cover object-center translate-y-[35%] lg:translate-y-0 lg:object-center"      
        />

      <!-- Nagłówek -->
      <header class="relative z-20 px-5 pt-6 pb-6 text-center lg:absolute lg:right-[7.5%] lg:top-[6%] lg:p-0 lg:text-right">
        <a
          href="#top"
          class="extra-bold text-sm font-bold uppercase tracking-wide text-wianek-rust sm:text-lg lg:text-xl"
          aria-label="Wydawnictwo Wianek — strona główna"
        >
          WYDAWNICTWO WIANEK
        </a>
      </header>

      <!-- Tekst (środek) -->
      <section
        class="relative z-10 order-1 mx-auto mt-8 w-full max-w-xl px-5 text-center lg:absolute lg:left-[29%] lg:top-1/2 lg:mx-0 lg:mt-0 lg:w-[36%] lg:max-w-none lg:-translate-y-1/2 lg:px-0 lg:text-left"
      >
        <h1 class="extra-bold text-xl font-bold uppercase leading-snug tracking-wide text-wianek-rust sm:text-2xl lg:text-wianek-cream lg:text-[clamp(1.4rem,2.4vw,2.3rem)]">
          Zostań częścią<br />wiankowych historii!
        </h1>
        <p class="mt-1 text-sm leading-relaxed text-wianek-rust sm:text-sm lg:text-wianek-cream lg:text-[clamp(1rem,1.5vw,1.35rem)]">
          Nie przegap darmowych materiałów do zabawy<br /> i pracy z naszymi książkami, ciekawostek<br class="lg:hidden" /> oraz nowości.
        </p>

        <button
          id="open-subscription"
          type="button"
          class="extra-bold mt-8 inline-flex min-h-12 items-center justify-center rounded-full bg-wianek-green px-8 py-3 text-base font-bold uppercase text-wianek-cream shadow-lg shadow-wianek-green/20 transition hover:-translate-y-0.5 hover:bg-wianek-green-dark lg:mt-12 lg:ml-[30%] lg:px-12 lg:py-5 lg:text-2xl"
        >
          Dołącz do nas
        </button>
      </section>


      <img
        src={people.src}
        alt="Twórczynie Wydawnictwa Wianek z książkami"
        loading="eager"
        decoding="async"
        class="absolute left-1/2 -translate-x-1/2 -bottom-[8%] z-10
        w-[38%] max-w-none
        lg:left-auto lg:translate-x-0 lg:right-[9%] lg:-bottom-[10%] lg:w-[13%]"      
      />

      <!-- Formularz zapisu -->
      <div
        id="subscription-overlay"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm p-6"
      >
        <div
          id="subscription-panel"
          class="subscription-panel relative w-full max-w-xl rounded-[2rem] p-5 sm:p-8"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-sm font-semibold uppercase text-wianek-green">Newsletter Wianka</p>
              <h2 class="mt-2 text-2xl font-bold text-wianek-rust sm:text-3xl">Zapisz swój e-mail</h2>
            </div>
            <button
              id="close-subscription"
              type="button"
              aria-label="Zamknij formularz"
              class="rounded-full border border-wianek-rust/20 px-3 py-1 text-wianek-rust transition hover:bg-wianek-cream-dark"
            >
              ×
            </button>
          </div>

          <p class="mt-3 text-wianek-rust/90">
            Otrzymuj wiankowe inspiracje, darmowe materiały i wiadomości<br/> o nowych książkach.
          </p>

          <form id="subscription-form" class="mt-6 grid gap-4" novalidate>
            <label for="name" class="text-sm font-semibold text-wianek-green">
              Imię
            </label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              inputmode="text"
              maxlength="100"
              required
              placeholder="Twoje imię"
              class="min-h-12 rounded-xl border border-wianek-rust/25 bg-white/70 px-4 py-3 text-wianek-rust placeholder:text-wianek-rust/45 focus:border-wianek-green focus:outline-none focus:ring-2 focus:ring-wianek-green/20"
            />

            <label for="email" class="text-sm font-semibold text-wianek-green">
              E-mail
            </label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              maxlength="254"
              required
              placeholder="twojadres@example.com"
              class="min-h-12 rounded-xl border border-wianek-rust/25 bg-white/70 px-4 py-3 text-wianek-rust placeholder:text-wianek-rust/45 focus:border-wianek-green focus:outline-none focus:ring-2 focus:ring-wianek-green/20"
            />

            <label class="flex cursor-pointer items-start gap-3 text-sm leading-6 text-wianek-rust/90">
              <input
                name="consent"
                type="checkbox"
                required
                class="mt-1 h-5 w-5 shrink-0 accent-[#474c2c]"
              />
              <span>
                Chcę otrzymywać newsletter Wydawnictwa Wianek na podany przeze mnie adres e-mail. W newsletterze znajdę informacje o naszych nowych książkach i produktach, darmowe materiały, ciekawostki oraz oferty specjalne. Wiem, że mogę w każdej chwili zrezygnować z otrzymywania newslettera.
              </span>
            </label>
            <p class="text-xs text-wianek-rust/70">
              Administratorem Twoich danych osobowych jest Wydawnictwo Wianek. Szczegółowe informacje dotyczące przetwarzania danych osobowych znajdziesz w
              <a href="/regulamin-newslettera" class="underline hover:text-wianek-green transition" target="_blank" rel="noopener noreferrer">
                Regulaminie newslettera
              </a>.
            </p>
            <button
              id="submit-subscription"
              type="submit"
              class="mt-2 inline-flex min-h-12 items-center justify-center rounded-xl bg-wianek-green px-6 py-3 font-bold text-wianek-cream transition hover:-translate-y-0.5 hover:bg-wianek-green-dark disabled:cursor-wait disabled:opacity-70"
            >
              DOŁĄCZ DO NAS
            </button>
            <p
              id="form-status"
              role="status"
              aria-live="polite"
              class="status-message text-sm font-semibold"
            ></p>
          </form>
        </div>
      </div>
    </main>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const openButton = document.querySelector('#open-subscription');
        const closeButton = document.querySelector('#close-subscription');
        const overlay = document.querySelector('#subscription-overlay');
        const form = document.querySelector('#subscription-form');
        const emailInput = document.querySelector('#email');
        const submitButton = document.querySelector('#submit-subscription');
        const status = document.querySelector('#form-status');

        const setPanelVisible = (visible) => {
          overlay.classList.toggle('hidden', !visible);
          overlay.classList.toggle('flex', visible);

          // Blokuje przewijanie strony
          document.body.style.overflow = visible ? 'hidden' : '';

          if (visible) {
            window.setTimeout(() => emailInput?.focus(), 50);
          }
        };

        openButton?.addEventListener('click', () => setPanelVisible(true));
        closeButton?.addEventListener('click', () => setPanelVisible(false));

        // Zamykanie po kliknięciu w tło
        overlay?.addEventListener('click', (event) => {
          if (event.target === overlay) {
            setPanelVisible(false);
          }
        });

        form?.addEventListener('submit', async (event) => {
          event.preventDefault();
          status.textContent = '';
          status.className = 'status-message text-sm font-semibold';

          if (!form.checkValidity()) {
            form.reportValidity();
            return;
          }

          const formData = new FormData(form);
          submitButton.disabled = true;
          submitButton.textContent = 'ZAPISUJEMY…';

          try {
            const response = await fetch('/api/subscribe', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
              },
              body: JSON.stringify({
                name: formData.get('name'),
                email: formData.get('email'),
                consent: formData.get('consent') === 'on',
              }),
            });

            const result = await response.json().catch(() => ({}));

            if (!response.ok) {
              throw new Error(result.message || 'Nie udało się zapisać adresu.');
            }

            status.textContent = result.message || 'Dziękujemy! Twój adres został zapisany.';
            status.classList.add('is-success');
            form.reset();

            // Zamknij modal po 1,5 s
            setTimeout(() => setPanelVisible(false), 1500);
            status.textContent = ' ';
          } catch (error) {
            status.textContent = error instanceof Error
              ? error.message
              : 'Spróbuj ponownie za chwilę.';
            status.classList.add('is-error');
          } finally {
            submitButton.disabled = false;
            submitButton.textContent = 'DOŁĄCZ DO NAS';
          }
        });
      });
    </script>
  </body>
</html>