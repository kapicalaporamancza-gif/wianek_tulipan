---
import backgroundShape from '../../resources/O_Kaktusku_tlo.webp';
import kaktus from '../../resources/O_Kaktusku_zadziorku.webp';
import SubscriptionModal from '../components/SubscriptionModal.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Wydawnictwo Wianek — O Kaktusku Zadziorku"
  description="Dołącz do społeczności Wydawnictwa Wianek i otrzymuj darmowe materiały, ciekawostki, nowości oraz oferty specjalne."
>
  <!-- Tło -->
  <img
    src={backgroundShape.src}
    alt=""
    aria-hidden="true"
class="pointer-events-none absolute inset-0 z-0 h-screen w-full object-cover object-center lg:object-fill"  />

  <!-- Nagłówek -->
  <header class="relative z-20 px-5 pt-6 pb-6 text-center lg:absolute lg:right-[7.5%] lg:top-[6%] lg:p-0 lg:text-right">
    <a
      href="#top"
      class="extra-bold text-sm font-bold uppercase tracking-wide text-wianek-green sm:text-lg lg:text-xl"
      aria-label="Wydawnictwo Wianek — strona główna"
    >
      WYDAWNICTWO WIANEK
    </a>
  </header>

  <!-- Tekst (środek) -->
  <section
    class="relative z-10 order-1 mx-auto mt-8 w-full max-w-xl px-5 text-center lg:absolute lg:left-[50%] lg:top-1/2 lg:mx-0 lg:mt-0 lg:w-[36%] lg:max-w-none lg:-translate-y-1/2 lg:px-0 lg:text-left"
  >
    <h1 class="extra-bold text-xl font-bold uppercase leading-snug tracking-wide text-wianek-green sm:text-2xl lg:text-[clamp(1.4rem,2.4vw,2.3rem)]">
      Zostań częścią<br />wiankowych historii!
    </h1>
    <p class="mt-1 text-sm leading-relaxed text-wianek-green sm:text-sm  lg:text-[clamp(1rem,1.5vw,1.35rem)]">
      Nie przegap darmowych materiałów do zabawy<br /> i pracy z naszymi książkami, ciekawostek<br class="lg:hidden" /> oraz nowości.
    </p>

    <button
      id="open-subscription"
      type="button"
      class="extra-bold mt-8 inline-flex min-h-12 items-center justify-center rounded-full bg-wianek-rust px-8 py-3 text-base font-bold uppercase text-wianek-cream shadow-lg shadow-wianek-green/20 transition hover:-translate-y-0.5 hover:bg-wianek-green-dark lg:mt-12 lg:px-12 lg:py-5 lg:text-2xl"
    >
      Dołącz do nas
    </button>
  </section>

  <img
    src={kaktus.src}
    alt="Kaktus Zadziorek i Gwiazdka"
    loading="eager"
    decoding="async"
  class="absolute left-1/2 -translate-x-1/2 bottom-[6%] z-10 w-[85%] max-w-none lg:left-[8%] lg:translate-x-0 lg:right-auto lg:bottom-[4%] lg:w-[39%]"
  />

  <SubscriptionModal theme="kaktus" />
</Layout>
